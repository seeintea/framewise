          }
        }
      }
    },
    "camera.access.alert.restricted.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device does not allow one or more permissions required for capture. Check Screen Time or device management settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备不允许应用获得拍摄所需的一项或多项权限。请检查屏幕使用时间或设备管理设置。"
          }
        }
      }
    },
    "camera.access.alert.restricted.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {

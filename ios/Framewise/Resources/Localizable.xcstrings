    "camera.access.alert.denied.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One or more permissions required for capture were denied. Allow access in Settings, then return to continue."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍摄所需的一项或多项权限已被拒绝。请在系统设置中允许访问，然后返回继续拍摄。"
          }
        }
      }
    },

    "camera.access.alert.request.live-photo.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capturing and saving Live Photos requires camera, add-only photo library, and microphone access. The system will request each permission after you continue."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍摄和保存实况照片需要相机、相册添加和麦克风权限。继续后，系统会依次请求这些权限。"
          }
        }
      }
    },
    "camera.access.alert.request.photo.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",

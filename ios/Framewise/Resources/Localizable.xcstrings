    "camera.access.alert.denied.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One or more permissions required for capture were denied. Allow access in Settings, then return to continue."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍摄所需的一项或多项权限已被拒绝。请在系统设置中允许访问，然后返回继续拍摄。"
          }
        }
      }
    },
    "camera.access.alert.denied.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permissions Required"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要开启权限"
          }
        }
      }
    },
    "camera.access.alert.request.live-photo.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capturing and saving Live Photos requires camera, add-only photo library, and microphone access. The system will request each permission after you continue."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍摄和保存实况照片需要相机、相册添加和麦克风权限。继续后，系统会依次请求这些权限。"
          }
        }
      }
    },
    "camera.access.alert.request.photo.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capturing and saving photos requires camera and add-only photo library access. The system will request each permission after you continue."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍摄和保存照片需要相机与相册添加权限。继续后，系统会依次请求这些权限。"
          }
        }
      }
    },
    "camera.access.alert.request.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Capture Access"
          }

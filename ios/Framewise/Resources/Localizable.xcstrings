        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "权限访问受限制"
          }
        }
      }
    },
    "camera.access.alert.unavailable.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The required permission status is temporarily unavailable. Try again later."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍摄所需的权限状态暂时不可用，请稍后重试。"
          }
        }
      }
    },
    "camera.access.alert.unavailable.title" : {
      "extractionState" : "manual",
